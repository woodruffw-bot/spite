"/(?:(?:(?:(a)(\u005c1)+){2})|)*/.test('aa')" "{\u0022result\u0022:true}"
"/(?:(?:(?:(a)(?:\u005c1\u005c1)+){2})|)*/.test('aaa')" "{\u0022result\u0022:true}"
"/(?:(?:(?:(a)(?:a\u005c1)+){2})|)*/.test('aaa')" "{\u0022result\u0022:true}"
"/(a)(?:\u005c1|b)+/.test('aa')" "{\u0022result\u0022:true}"
"/(a)(?:\u005c1*)+/.test('aa')" "{\u0022result\u0022:true}"
"/(?<=((a|a*){1}){0})b/.exec('b')" "{\u0022result\u0022:[\u0022b\u0022,null,null]}"
"/(?:a|())+b/.exec('ab')" "{\u0022result\u0022:[\u0022ab\u0022,null]}"
"/(?:(?:a|())+)*b/.exec('ab')" "{\u0022result\u0022:[\u0022ab\u0022,null]}"
"/(?:(?=(a))|b)+/.exec('a')" "{\u0022result\u0022:[\u0022\u0022,\u0022a\u0022]}"
"/(?:(?=(a))\u005c1|b)+/.exec('a')" "{\u0022result\u0022:[\u0022a\u0022,\u0022a\u0022]}"
"/(?:(?=(a))|b)+/.exec('a')" "{\u0022result\u0022:[\u0022\u0022,\u0022a\u0022]}"
"/(?:(?=(a))\u005c1|b)+/.exec('a')" "{\u0022result\u0022:[\u0022a\u0022,\u0022a\u0022]}"
