---
source: crates/spite-parser/tests/arrow_covers.rs
expression: diagnostics
---
[
    (
        "(x = /[)]/)\n=> x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 12,
                end: 14,
            },
            message: "line terminator before arrow",
        },
    ),
    (
        "(x = /[)]/u) /*\n*/ => x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 19,
                end: 21,
            },
            message: "line terminator before arrow",
        },
    ),
    (
        "(x = /a/gg) => x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 5,
                end: 10,
            },
            message: "duplicate regular expression flag",
        },
    ),
    (
        "(x = /[/) => x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 5,
                end: 14,
            },
            message: "unterminated regular expression literal",
        },
    ),
    (
        "(x = /a\n/) => x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 5,
                end: 8,
            },
            message: "line terminator in regular expression literal",
        },
    ),
    (
        "(x = /(/) => x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 5,
                end: 8,
            },
            message: "unterminated regular expression group",
        },
    ),
    (
        "({x=1})",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 3,
                end: 4,
            },
            message: "initialized shorthand is not allowed in an object literal",
        },
    ),
    (
        "({__proto__:1,__proto__:2})",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 14,
                end: 23,
            },
            message: "duplicate prototype setter in object literal",
        },
    ),
    (
        "(for)=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 1,
                end: 4,
            },
            message: "invalid arrow binding identifier",
        },
    ),
    (
        "(return)=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 1,
                end: 7,
            },
            message: "invalid arrow binding identifier",
        },
    ),
    (
        "(enum)=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 1,
                end: 5,
            },
            message: "invalid arrow binding identifier",
        },
    ),
    (
        "(...[x],)=>x",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 7,
                end: 8,
            },
            message: "expected )",
        },
    ),
    (
        "(...x=[])=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 5,
                end: 6,
            },
            message: "expected )",
        },
    ),
    (
        "([...[x]=[]])=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 8,
                end: 9,
            },
            message: "expected ]",
        },
    ),
    (
        "([...x,y])=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 6,
                end: 7,
            },
            message: "expected ]",
        },
    ),
    (
        "({bre\\u0061k})=>1",
        Diagnostic {
            kind: Syntax,
            span: Span {
                start: 2,
                end: 12,
            },
            message: "invalid binding identifier",
        },
